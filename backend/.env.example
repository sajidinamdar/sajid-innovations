# Environment Configuration for sajidtech Backend (FastAPI + PostgreSQL)

# Application
PROJECT_NAME="sajidtech Backend API"
ENVIRONMENT="production"
PORT=8000
HOST="0.0.0.0"

# Security & Admin Secrets
SECRET_KEY="replace_with_a_secure_random_64_character_hex_string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace_with_a_strong_production_admin_password"

# Database Configuration (PostgreSQL in production; SQLite fallback for local test suite)
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/sajidtech_db"

# Allowed CORS Origins
CORS_ORIGINS=["http://localhost:3000","https://sajidtech.vercel.app"]

# Email Notifications (Optional)
EMAIL_ENABLED=false
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
EMAIL_FROM="inamdarsajid46@gmail.com"
ADMIN_NOTIFICATION_EMAIL="inamdarsajid46@gmail.com"

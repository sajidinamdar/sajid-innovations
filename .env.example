# Neon PostgreSQL Connection URL (Serverless Database)
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require"

# Administrator Authentication Configuration
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your-strong-admin-password"
ADMIN_SESSION_SECRET="your-32-char-random-session-signing-secret"

# Gemini API Key
GEMINI_API_KEY="your-gemini-api-key-here"

# Application URL
APP_URL="http://localhost:3000"

# SMTP Configuration for Direct Email Inbound Alerts
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-gmail-app-password"
NOTIFICATION_RECIPIENT="your-email@gmail.com"
# NOTIFICATION_EMAIL="your-email@gmail.com" # Alternative alias for NOTIFICATION_RECIPIENT
SENDER_NAME="Sajid Innovations"
SMTP_TEST_MODE="false"
